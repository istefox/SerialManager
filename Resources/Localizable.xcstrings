        }
      }
    },
    "Your changes to this license will be lost.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche a questa licenza andranno perse."
          }
        }
      }
    },
    "Your current licenses are overwritten with the ones in the backup.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le licenze attuali vengono sovrascritte con quelle del backup."
          }
        }
      }
    },
    "Your current licenses stay as they are.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le licenze attuali restano come sono."
          }
        }
      }
    }
  },
  "version": "1.0"
}