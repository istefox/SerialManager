        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriale copiato"
          }
        }
      }
    },
    "SerialManager couldn't open its library file. Quit and reopen the app; if this keeps happening, check the disk.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SerialManager non è riuscito ad aprire il file dell'archivio. Esci e riapri l'app; se il problema si ripete, controlla il disco."
          }
        }
      }
    },
    "Show Serial": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra seriale"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "Show or Hide Serial": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nascondi seriale"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta"
          }
        }
      }
    },
    "Skipped: %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltate: %lld"
          }
        }
      }
    },
    "The backup contains all your licenses and serials, encrypted with this password. You need it to restore the backup: it can't be recovered if you forget it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup contiene tutte le tue licenze e i seriali, cifrati con questa password. Ti servirà per ripristinare il backup: se la dimentichi non si può recuperare."
          }
        }
      }
    },
    "The backup couldn't be encrypted. Try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile cifrare il backup. Riprova."
          }
        }
      }
    },
    "The backup is larger than 64 MB, the maximum size.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup supera i 64 MB, la dimensione massima."
          }
        }
      }
    },
    "The current serial couldn't be read, so saving now would remove it. Enter the serial again, or close the form and try later.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il seriale attuale: salvando ora verrebbe cancellato. Inseriscilo di nuovo, oppure chiudi il modulo e riprova più tardi."
          }
        }
      }
    },
    "The import stopped. Imported: %lld. Replaced: %lld.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importazione si è interrotta. Importate: %lld. Sostituite: %lld."
          }
        }
      }
    },
    "The password is incorrect.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password non è corretta."
          }
        }
      }
    },
    "The passwords don't match.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le password non coincidono."
          }
        }
      }
    },
    "The serial for this license is missing from the Keychain.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seriale di questa licenza non è nel Portachiavi."
          }
        }
      }
    },
    "This also removes its serial from the Keychain. This can't be undone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eliminato anche il seriale dal Portachiavi. L'operazione non si può annullare."
          }
        }
      }
    },
    "This backup was made with a newer version of SerialManager.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup è stato creato con una versione più recente di SerialManager."
          }
        }
      }
    },
    "This file isn't a valid SerialManager backup.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un backup valido di SerialManager."
          }
        }
      }
    },
