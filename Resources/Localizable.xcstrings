          "stringUnit": {
            "state": "translated",
            "value": "Cerca nelle note"
          }
        }
      }
    },
    "Search product names": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nei nomi dei prodotti"
          }
        }
      }
    },
    "Search registered names": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nel nome e cognome"
          }
        }
      }
    },
    "Search vendors": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nei produttori"
          }
        }
      }
    },
    "Select a License": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una licenza"
          }
        }
      }
    },
    "Serial": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriale"
          }
        }
      }
    },
    "Serial copied": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriale copiato"
          }
        }
      }
    },
    "SerialManager couldn't open its library file. Quit and reopen the app; if this keeps happening, check the disk.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SerialManager non è riuscito ad aprire il file dell'archivio. Esci e riapri l'app; se il problema si ripete, controlla il disco."
          }
        }
      }
    },
    "SerialManager couldn't reach the key that protects your attachments. Allow access when macOS asks, then try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SerialManager non ha potuto accedere alla chiave che protegge i tuoi allegati. Consenti l'accesso quando macOS lo chiede, poi riprova."
          }
        }
      }
    },
    "Show Serial": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra seriale"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra nel Finder"
          }
        }
      }
    },
    "Show or Hide Serial": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nascondi seriale"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta"
          }
        }
      }
    },
    "Skipped: %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltate: %lld"
          }
        }
      }
    },
    "Sort By": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina per"
          }
        }
      }
    },
    "Sort and Search Options": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzioni di ordinamento e ricerca"
          }
        }
      }
    },
    "Sorted by %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinato per %@"
          }
        }
      }
    },
    "The backup contains all your licenses and serials, encrypted with this password. You need it to restore the backup: it can't be recovered if you forget it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup contiene tutte le tue licenze e i seriali, cifrati con questa password. Ti servirà per ripristinare il backup: se la dimentichi non si può recuperare."
          }
        }
      }
    },
    "The backup couldn't be encrypted. Try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile cifrare il backup. Riprova."
          }
        }
      }
    },
    "The backup is larger than 64 MB, the maximum size. Attachments are the usual cause: remove a few of the largest ones and try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup supera i 64 MB, la dimensione massima. Di solito la causa sono gli allegati: rimuovine qualcuno fra i più grandi e riprova."
          }
        }
      }
    },
    "The current serial couldn't be read, so saving now would remove it. Enter the serial again, or close the form and try later.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il seriale attuale: salvando ora verrebbe cancellato. Inseriscilo di nuovo, oppure chiudi il modulo e riprova più tardi."
          }
        }
      }
    },
    "The file of this attachment is missing, so it can't be opened. You can remove it and add the file again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di questo allegato è mancante, quindi non può essere aperto. Puoi rimuoverlo e aggiungere di nuovo il file."
          }
        }
      }
    },
    "The import stopped. Imported: %lld. Replaced: %lld.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importazione si è interrotta. Importate: %lld. Sostituite: %lld."
          }
        }
      }
    },
    "The key that protects your attachments couldn't be read from the Keychain.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere dal Portachiavi la chiave che protegge i tuoi allegati."
          }
        }
      }
    },
    "The key that protects your attachments is missing from the Keychain, so they can't be read. Restore a backup of your Keychain, or import a SerialManager backup.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave che protegge i tuoi allegati non è più nel Portachiavi, quindi non possono essere letti. Ripristina un backup del Portachiavi, oppure importa un backup di SerialManager."
          }
        }
      }
    },
    "The key that protects your attachments is stored in a form SerialManager doesn't recognize.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave che protegge i tuoi allegati è memorizzata in una forma che SerialManager non riconosce."
          }
        }
      }
    },
    "The license was saved, but %@ couldn't be added: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La licenza è stata salvata, ma non è stato possibile aggiungere %@: %@"
          }
        }
      }
    },
    "The license was saved, but %@ couldn't be added: %@ %lld files were not added.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La licenza è stata salvata, ma non è stato possibile aggiungere %@: %@ %lld file non sono stati aggiunti."
          }
        }
      }
    },
    "The license was saved, but an attachment couldn't be removed: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La licenza è stata salvata, ma non è stato possibile rimuovere un allegato: %@"
          }
        }
      }
    },
    "The password is incorrect.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password non è corretta."
          }
        }
      }
    },
    "The passwords don't match.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le password non coincidono."
          }
        }
      }
    },
    "The serial for this license is missing from the Keychain.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seriale di questa licenza non è nel Portachiavi."
          }
        }
      }
    },
    "This also removes its serial from the Keychain. This can't be undone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eliminato anche il seriale dal Portachiavi. L'operazione non si può annullare."
          }
        }
      }
    },
    "This attachment couldn't be decrypted. Its file may be damaged.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile decifrare questo allegato. Il suo file potrebbe essere danneggiato."
          }
        }
      }
    },
    "This attachment couldn't be encrypted. Try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile cifrare questo allegato. Riprova."
          }
        }
      }
    },
    "This attachment is no longer in your library.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo allegato non è più nella tua libreria."
          }
        }
      }
    },
    "This backup was made with a newer version of SerialManager.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup è stato creato con una versione più recente di SerialManager."
          }
        }
      }
    },
    "This file isn't a valid SerialManager backup.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un backup valido di SerialManager."
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        }
      }
    },
    "Use at least 12 characters.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa almeno 12 caratteri."
          }
        }
      }
    },
    "Vendor": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Produttore"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versione"
          }
        }
      }
    },
    "Will be added when you save": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà aggiunto al salvataggio"
          }
        }
      }
    },
    "Will be removed when you save": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimosso al salvataggio"
          }
        }
      }
    },
    "Without a serial in the Keychain: %lld": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza seriale nel Portachiavi: %lld"
          }
        }
      }
    },
    "Your changes to this license will be lost.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche a questa licenza andranno perse."
          }
        }
      }
    },
    "Your current licenses are overwritten with the ones in the backup.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le licenze attuali vengono sovrascritte con quelle del backup."
          }
        }
      }
    },
    "Your current licenses stay as they are.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le licenze attuali restano come sono."
          }
        }
      }
    },
    "macOS found no application to open “%@”. Use Save a Copy and open it yourself.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha trovato un'applicazione per aprire “%@”. Usa Salva una copia e aprilo tu."
          }
        }
      }
    },
    "“%@” is larger than %@, the maximum size of one attachment.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” supera %@, la dimensione massima di un singolo allegato."
          }
        }
      }
    }
  },
  "version": "1.0"
}
