    "Adding “%@” would take this license over %@ of attachments, its maximum.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere “%@” porterebbe questa licenza oltre %@ di allegati, il suo massimo."
          }
        }
      }
    },
    "Adding “%@” would take your library over %@ of attachments in total, the maximum that still fits in a backup.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere “%@” porterebbe la tua libreria oltre %@ di allegati in totale, il massimo che sta ancora in un backup."
