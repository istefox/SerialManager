{
  "sourceLanguage": "en",
  "strings": {
    "Add License": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi licenza"
          }
        }
      }
    },
    "Add Serial…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi seriale…"
          }
        }
      }
    },
    "Add the serial numbers of your software to find them here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i numeri di serie dei tuoi programmi per ritrovarli qui."
          }
        }
      }
    },
    "After 1 Minute": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo 1 minuto"
          }
        }
      }
    },
    "After 2 Minutes": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo 2 minuti"
          }
        }
      }
    },
    "After 30 Seconds": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo 30 secondi"
          }
        }
      }
    },
    "After you copy a serial, SerialManager removes it from the clipboard. Anything you copy afterwards is left alone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo che hai copiato un seriale, SerialManager lo toglie dagli appunti. Quello che copi dopo non viene toccato."
          }
        }
      }
    },
    "Already in SerialManager: %lld of %lld licenses.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in SerialManager: %1$lld of %#@licenses@."
          },
          "substitutions": {
            "licenses": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg license"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg licenses"
                    }
                  }
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già in SerialManager: %#@licenses@ su %2$lld."
          },
          "substitutions": {
            "licenses": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg licenza"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg licenze"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Backup Exported": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup esportato"
          }
        }
      }
    },
    "Backup isn't available yet in this version of SerialManager.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup non è ancora disponibile in questa versione di SerialManager."
